# Copy to .env and adjust. Every value here has a working default.

# --- Core -------------------------------------------------------------
# Signs the session cookie. The default in config.py is published in this
# repository, so the application REFUSES to start in production until you set a
# real one here. Generate it with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# development = debug server, localhost only
# production  = safety checks on, use wsgi.py with Waitress or Gunicorn
FLASK_ENV=development

# --- Hosting on a server (see DEPLOYMENT.md) --------------------------
# Send the session cookie only over HTTPS.
#   false = serving plain http://   true = TLS is in front
# Getting this wrong over http:// makes the login POST fail with a 400 and
# nothing in the interface explains why.
SESSION_COOKIE_SECURE=false

# true only when nginx, Caddy or IIS sits in front, so the audit trail records
# the real client address instead of the proxy's.
BEHIND_PROXY=false

# Address the production server binds to. 0.0.0.0 = reachable from other machines.
HOST=0.0.0.0
PORT=8000

# The software's own name, shown in the browser title, the sidebar, the sign-in
# page and the footer of every PDF report. Constant across deployments.
SYSTEM_NAME=Intelligent Hospital Workforce Scheduling System
SYSTEM_ABBR=IHWSS

# The institution running this instance. Change this per deployment.
HOSPITAL_NAME=Taifa Hospital

# --- Database ---------------------------------------------------------
# SQLite needs no server. To move to MySQL later, change this one line:
#   DATABASE_URL=mysql+pymysql://root:@localhost/hospital_db
# DATABASE_URL=sqlite:///instance/hospital.db

# --- Scheduling policy: hard constraints ------------------------------
# The engine refuses to produce any roster that breaks these.
MIN_REST_HOURS=11
MAX_WEEKLY_HOURS=48
MAX_CONSECUTIVE_DAYS=6
MAX_CONSECUTIVE_NIGHTS=3
MIN_DAYS_OFF_PER_WEEK=1

# --- Scheduling: heuristic optimiser ----------------------------------
OPTIMISER_ITERATIONS=4000
# Set an integer for reproducible rosters during a demonstration.
# OPTIMISER_SEED=42

# --- Attendance -------------------------------------------------------
ATTENDANCE_GRACE_MINUTES=15
OVERTIME_THRESHOLD_MINUTES=30

# --- Notifications ----------------------------------------------------
# console = compose and log to the outbox, no gateway, no cost (default)
# smtp    = real email        http = real SMS gateway
EMAIL_BACKEND=console
SMS_BACKEND=console

# Fill these in and set EMAIL_BACKEND=smtp to send real email.
# Gmail requires an app password, not your normal account password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=no-reply@taifahospital.gh

# Fill these in and set SMS_BACKEND=http to send real SMS.
# Works with Hubtel, Arkesel and similar JSON gateways.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=TAIFA

# --- Seed data --------------------------------------------------------
DEFAULT_PASSWORD=Password123
